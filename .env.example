# Copy to .env and fill in real values. NEVER commit .env.

# ---- PostgreSQL ----
# Owner/admin connection: used by the app for query_logs and by Prisma migrations + seed.
# Local:    postgresql://<you>@localhost:5432/ai_db_copilot
# Supabase: the "Transaction pooler" URL (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ai_db_copilot"
# Optional: direct (non-pooled) connection used for migrations/seed (Supabase "Session pooler"/direct, port 5432).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Read-only connection used ONLY by the MCP server. Create the role with `npm run db:readonly`
# (it reads the role name + password from this URL). Pick a strong random password.
# Supabase pooler: username becomes mcp_readonly.<project-ref>
MCP_DATABASE_URL="postgresql://mcp_readonly:CHANGE_ME_STRONG_PASSWORD@HOST:5432/ai_db_copilot"

# ---- Gemini (server-side only) ----
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"

# ---- Auth.js / NextAuth v5 ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="generate-a-random-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
